# --- Documents and storage -------------------------------------------------------
# One sub folder per collection: samples/docs/general, samples/docs/hr, samples/docs/finance
KB_DOCS_DIR=samples/docs
KB_DB=kb.db
# Words treated as the same word (holiday = leave). Default: kb/synonyms.txt. "off" for none.
# KB_SYNONYMS=kb/synonyms.txt

# --- How passages are found ----------------------------------------------------------------
# hybrid: by keywords (BM25) and by meaning (a local embedding model; no API key, no cost per
#         question). The model is downloaded once, about 67 MB: python -m kb download-model
# bm25:   by keywords only, nothing to download
KB_RETRIEVER=hybrid
# KB_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Where the model is kept. Default: the models folder of this project.
# KB_MODEL_DIR=models

# --- Who may read what -------------------------------------------------------------
# One token per person or agent. The role decides which collections the token may read.
# Generate real tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_TOKENS='{"change-me-staff-token-00000": {"name": "maria", "role": "staff"}, "change-me-hr-token-000000000": {"name": "hana", "role": "hr"}, "change-me-finance-token-0000": {"name": "farid", "role": "finance"}, "change-me-admin-token-000000": {"name": "it-admin", "role": "admin"}}'
# Optional. Roles and the collections they may read. The role named admin always reads every
# collection ("*"), may add and remove documents, and reads the audit log. These are the defaults:
# KB_ROLES='{"staff": ["general"], "hr": ["general", "hr"], "finance": ["general", "finance"], "admin": ["*"]}'

# --- How answers are written ---------------------------------------------------------
# extractive: sentences quoted from the documents, no AI model, no API key (the default)
# claude:     one Claude API call per question, every citation checked in code
#             (written and tested with simulated replies; not run against the live API by the author)
KB_ANSWER_MODE=extractive
# ANTHROPIC_API_KEY=
# The project's own names (KB_CLAUDE_*). Generic names such as ANTHROPIC_MODEL or CLAUDE_EFFORT,
# which other tools may set globally, are not read; the server says so at start if they are set.
# KB_CLAUDE_MODEL=claude-sonnet-5-5
# Effort: low by default where the model accepts it. Checked at start against what the model accepts.
# KB_CLAUDE_EFFORT=low
# Server-side fallback when the model declines a request (on by default for the models that have
# one; set off to disable):
# KB_CLAUDE_FALLBACKS=default
# Claude answers per person per minute, and per day for everyone together. Above these, answers
# are quoted from the documents instead (no API call), with a warning.
# KB_CLAUDE_PER_MINUTE=10
# KB_CLAUDE_PER_DAY=500
# Claude answers per person (per token) per day:
# KB_CLAUDE_PER_PERSON_DAY=100

# --- Used by the command line (ask, search, docs, audit) --------------------------------
# If you start the server with --port, change the port here too.
KB_URL=http://127.0.0.1:8200
KB_TOKEN=change-me-staff-token-00000

# --- Used by python -m kb mcp-stdio (a local MCP client such as Claude Desktop) ------------
KB_MCP_TOKEN=change-me-staff-token-00000
